            <div class="form-group">
                <label>Fulfillment Preference</label>
                <select id="fulfillment" onchange="toggleAddressField()">
                    <option value="pickup">Store Pickup (Free)</option>
                    <option value="delivery">Home Delivery (Extra charges based on Grab rates)</option>
                </select>
            </div>

            <div class="form-group" id="addressGroup" style="display: none;">
                <label>Delivery Address</label>
                <textarea id="deliveryAddress" rows="2" placeholder="Enter full delivery address in RM..."></textarea>
                <small style="color: var(--primary-terracotta); font-size: 0.75rem;">*Delivery fee calculated based on live Grab courier charges and billed separately.</small>
