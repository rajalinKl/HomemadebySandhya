        <p style="margin-top: 1.5rem; font-size: 0.85rem;">WhatsApp Direct: <a href="https://wa.me/60174442997" target="_blank">+60 17-444 2997</a> | Instagram: <a href="https://www.instagram.com/homemadebysandhya?igsi=d3Y5M29oNDI3OWJt" target="_blank">@homemadebysandhya</a></p>
    </footer>

    <!-- Interactive Scripts -->
    <script>
        let currentItem = "";
        let currentPrice = 0;

        function openCheckout(name, price) {
            currentItem = name;
            currentPrice = price;
            document.getElementById('modalSummary').innerHTML = `<strong>Selected Item:</strong> ${name}<br><strong>Price:</strong> RM ${price.toFixed(2)}<br><small style="color:var(--primary-terracotta); font-weight:600;">⚠️ Reminder: Weekly orders require 2 days advance notice.</small>`;
            document.getElementById('checkoutModal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('checkoutModal').style.display = 'none';
        }

        function toggleAddressField() {
            const method = document.getElementById('fulfillment').value;
            const addressGroup = document.getElementById('addressGroup');
            if (method === 'delivery') {
                addressGroup.style.display = 'block';
            } else {
                addressGroup.style.display = 'none';
            }
        }

        function processPayment() {
            const method = document.getElementById('fulfillment').value;
            const address = document.getElementById('deliveryAddress').value;
            
            if (method === 'delivery' && !address.trim()) {
                alert('Please enter your delivery address.');
                return;
            }

            alert(`Redirecting securely to payment gateway (FPX / DuitNow QR / Cards)...\n\nItem: ${currentItem}\nFulfillment: ${method.toUpperCase()}\nBase Total: RM ${currentPrice.toFixed(2)}${method === 'delivery' ? '\n(Note: Grab delivery charges will be calculated and added separately).' : ''}`);
            closeModal();
        }

        window.onclick = function(event) {
            const modal = document.getElementById('checkoutModal');
            if (event.target === modal) closeModal();
        }
    </script>
