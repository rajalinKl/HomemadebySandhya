<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Homemade by Sandhya | Party & Catering Planner</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-cream: #FAF7F2;
            --card-bg: #FFFFFF;
            --primary-terracotta: #D87A5E;
            --primary-hover: #C26549;
            --sage-accent: #7C8C73;
            --pastel-blush: #F9EBEA;
            --pastel-lavender: #EFEBF5;
            --text-dark: #2A2827;
            --text-muted: #736E6B;
            --border-radius: 24px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: var(--bg-cream); color: var(--text-dark); overflow-x: hidden; line-height: 1.6; scroll-behavior: smooth; }
        h1, h2, h3, h4 { font-family: 'Playfair Display', serif; }

        /* Luxury Frosted Glass Navigation */
        nav { display: flex; justify-content: space-between; align-items: center; padding: 1.2rem 6%; background: rgba(250, 247, 242, 0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); position: sticky; top: 0; z-index: 1000; border-bottom: 1px solid rgba(216, 122, 94, 0.1); box-shadow: 0 4px 20px rgba(0,0,0,0.02); }
        .logo-area { display: flex; align-items: center; gap: 12px; text-decoration: none; }
        .logo-img { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; border: 1.5px solid var(--primary-terracotta); box-shadow: 0 4px 10px rgba(216,122,94,0.2); background-color: #fff; }
        .logo-text-group { display: flex; flex-direction: column; }
        .logo-title { font-size: 1.2rem; font-weight: 700; color: var(--text-dark); font-family: 'Playfair Display', serif; line-height: 1.1; }
        .logo-subtitle { font-size: 0.7rem; color: var(--primary-terracotta); font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
        
        .nav-links { display: flex; gap: 2rem; list-style: none; align-items: center; }
        .nav-links a { text-decoration: none; color: var(--text-dark); font-weight: 500; font-size: 0.95rem; transition: color 0.2s ease; }
        .nav-links a:hover { color: var(--primary-terracotta); }
        .insta-badge { background: rgba(249, 235, 234, 0.9); padding: 0.5rem 1.2rem; border-radius: 50px; font-size: 0.85rem; font-weight: 600; color: var(--primary-terracotta); text-decoration: none; transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1); border: 1px solid rgba(216,122,94,0.2); }
        .insta-badge:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(216,122,94,0.2); }

        /* Luxury Hero Section with Background Image */
        .hero { 
            position: relative;
            padding: 7rem 6% 6rem; 
            text-align: center; 
            background: linear-gradient(rgba(42, 40, 39, 0.65), rgba(42, 40, 39, 0.75)), url('https://images.unsplash.com/photo-1543353071-873f17a7a088?auto=format&fit=crop&w=1920&q=85') no-repeat center center/cover;
            color: white;
            background-attachment: fixed;
        }
        .hero h1 { font-size: 3.8rem; line-height: 1.2; margin-bottom: 1.2rem; font-weight: 700; text-shadow: 0 4px 20px rgba(0,0,0,0.3); }
        .hero p { font-size: 1.2rem; color: #F1ECE6; max-width: 700px; margin: 0 auto 2.5rem; font-weight: 300; text-shadow: 0 2px 10px rgba(0,0,0,0.3); }
        .hero-btns { display: flex; gap: 1.2rem; justify-content: center; }
        
        .btn-primary { background: var(--primary-terracotta); color: white; padding: 14px 32px; border-radius: 40px; text-decoration: none; font-weight: 600; transition: all 0.3s ease; border: none; cursor: pointer; box-shadow: 0 6px 20px rgba(216,122,94,0.3); }
        .btn-primary:hover { background: var(--primary-hover); transform: translateY(-3px); box-shadow: 0 10px 25px rgba(216,122,94,0.4); }
        .btn-secondary { background: rgba(255,255,255,0.15); backdrop-filter: blur(8px); color: white; border: 2px solid rgba(255,255,255,0.6); padding: 14px 32px; border-radius: 40px; text-decoration: none; font-weight: 600; transition: all 0.3s ease; cursor: pointer; }
        .btn-secondary:hover { background: white; color: var(--text-dark); transform: translateY(-3px); }

        /* Luxury Notice Banner */
        .notice-banner { background: rgba(249, 235, 234, 0.85); backdrop-filter: blur(5px); border: 1px solid rgba(216, 122, 94, 0.3); padding: 14px 24px; border-radius: 20px; text-align: center; max-width: 850px; margin: -30px auto 4rem; font-size: 0.9rem; font-weight: 600; color: #9E4D34; position: relative; z-index: 10; box-shadow: 0 10px 30px rgba(0,0,0,0.03); }

        /* Containers & Sections */
        .container { max-width: 1350px; margin: 0 auto; padding: 2rem 4%; }
        .section-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; border-bottom: 1px solid rgba(0,0,0,0.08); padding-bottom: 1rem; }
        .section-header h2 { font-size: 2.5rem; color: var(--text-dark); }
        .section-category-title { font-size: 1.7rem; color: var(--text-dark); margin: 3rem 0 1.5rem 0; padding-bottom: 0.5rem; border-bottom: 1px solid #E5E0D8; font-family: 'Playfair Display', serif; }

        /* Bento Grid Layout */
        .bento-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 28px; }
        .col-span-8 { grid-column: span 8; }
        .col-span-4 { grid-column: span 4; }
        .col-span-6 { grid-column: span 6; }
        .col-span-3 { grid-column: span 3; }

        .bento-card { background: var(--card-bg); border-radius: var(--border-radius); overflow: hidden; box-shadow: 0 15px 35px rgba(0,0,0,0.04); display: flex; flex-direction: column; transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); position: relative; border: 1px solid rgba(0,0,0,0.03); }
        .bento-card:hover { transform: translateY(-8px); box-shadow: 0 22px 50px rgba(0,0,0,0.09); border-color: rgba(216,122,94,0.2); }

        .bento-img-wrap { position: relative; width: 100%; height: 230px; overflow: hidden; }
        .bento-card.tall .bento-img-wrap { height: 380px; }
        .bento-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(0.165, 0.84, 0.44, 1); }
        .bento-card:hover .bento-img-wrap img { transform: scale(1.06); }

        .bento-content { padding: 2rem; display: flex; flex-direction: column; justify-content: space-between; flex: 1; }
        .badge { display: inline-block; background: var(--sage-accent); color: white; padding: 5px 14px; border-radius: 20px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 0.9rem; width: fit-content; box-shadow: 0 4px 10px rgba(124,140,115,0.2); }
        .badge.terracotta { background: var(--primary-terracotta); box-shadow: 0 4px 10px rgba(216,122,94,0.25); }

        .item-title { font-size: 1.4rem; font-weight: 700; margin-bottom: 0.5rem; letter-spacing: -0.3px; }
        .item-desc { font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 1.8rem; }

        .card-footer-flex { display: flex; justify-content: space-between; align-items: center; margin-top: auto; width: 100%; }
        .price-tag { font-size: 1.35rem; font-weight: 700; color: var(--primary-terracotta); }
        
        .order-btn { background: var(--pastel-lavender); color: #5B4E77; border: none; padding: 11px 22px; border-radius: 16px; font-weight: 600; font-size: 0.85rem; cursor: pointer; transition: all 0.3s ease; }
        .order-btn:hover { background: #DFD7EC; transform: scale(1.03); }

        /* Bespoke Catering Planner Section */
        .bespoke-wrapper { background: linear-gradient(135deg, #FDF3F0 0%, #EFEBE5 100%); border-radius: 36px; padding: 4.5rem; margin: 6rem 0; border: 1px solid rgba(216,122,94,0.2); box-shadow: 0 20px 50px rgba(0,0,0,0.03); }
        .bespoke-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 4.5rem; align-items: center; }
        .form-group { margin-bottom: 1.4rem; }
        .form-group label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 6px; color: var(--text-dark); }
        .form-group input, .form-group textarea, .form-group select { width: 100%; padding: 14px 18px; border-radius: 14px; border: 1px solid #DCD5CD; font-family: inherit; background: white; font-size: 0.95rem; transition: all 0.3s ease; }
        .form-group input:focus, .form-group textarea:focus, .form-group select:focus { outline: none; border-color: var(--primary-terracotta); box-shadow: 0 0 0 4px rgba(216,122,94,0.1); }

        /* Modal Overlay */
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(30,28,27,0.65); backdrop-filter: blur(8px); display: none; justify-content: center; align-items: center; z-index: 2000; }
        .modal-content { background: white; width: 90%; max-width: 520px; padding: 2.8rem; border-radius: 30px; box-shadow: 0 30px 60px rgba(0,0,0,0.2); position: relative; max-height: 90vh; overflow-y: auto; }
        .close-modal { position: absolute; top: 22px; right: 22px; background: #F3EFEA; border: none; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; font-weight: bold; font-size: 1rem; color: var(--text-dark); transition: background 0.2s; }
        .close-modal:hover { background: #E5DDD5; }

        /* Footer */
        footer { background: var(--text-dark); color: white; text-align: center; padding: 5rem 6%; margin-top: 7rem; border-top: 1px solid rgba(255,255,255,0.05); }
        footer a { color: #E8D3C8; text-decoration: none; transition: color 0.2s; }
        footer a:hover { color: white; }

        @media(max-width: 1024px) {
            .col-span-8, .col-span-4, .col-span-6, .col-span-3 { grid-column: span 12; }
            .bespoke-grid { grid-template-columns: 1fr; }
            .hero h1 { font-size: 2.8rem; }
        }
    </style>
</head>
